<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>
        <IsRoslynComponent>true</IsRoslynComponent>
		<Nullable>enable</Nullable>
		<IncludeBuildOutput>False</IncludeBuildOutput>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="5.3.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" PrivateAssets="all" />
    </ItemGroup>

	<ItemGroup>
		<Compile Include="../EnumClasses.SharedSources/**/*.cs" Link="ExternalSources\%(RecursiveDir)%(Filename)%(Extension)" Exclude="../EnumClasses.SharedSources/obj/**/*" />
	</ItemGroup>
	
	<PropertyGroup>
		<DefineConstants>$(DefineConstants);ENUMCLASSES_SOURCE_GENERATOR</DefineConstants>
	</PropertyGroup>
</Project>
