<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFrameworks>netstandard2.0;net8.0;net9.0;net10.0</TargetFrameworks>
	  <LangVersion>12.0</LangVersion>
	  <Nullable>enable</Nullable>

	  <PackageId>DDaarcon.EnumClasses</PackageId>
	  <Version>0.1.2-preview.2</Version>
	  <Authors>DDaarcon</Authors>
	  <Description>Source-generated enum-class types for C#.</Description>
	  <PackageTags>enum smart-enum source-generator roslyn</PackageTags>

	  <PackageProjectUrl>https://github.com/DDaarcon/EnumClassSourceGenerator</PackageProjectUrl>
	  <RepositoryUrl>https://github.com/DDaarcon/EnumClassSourceGenerator.git</RepositoryUrl>
	  <RepositoryType>git</RepositoryType>

	  <PackageReadmeFile>README.md</PackageReadmeFile>
	  <PackageLicenseExpression>MIT</PackageLicenseExpression>

	  <GenerateDocumentationFile>true</GenerateDocumentationFile>
	  <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	  <Deterministic>true</Deterministic>
  </PropertyGroup>

	<ItemGroup>
		<None Remove="LICENSE.txt" />
		<None Remove="README.md" />

		<None Include="LICENSE.txt"
			  Pack="true"
			  PackagePath="/" />
		<None Include="README.md"
			  Pack="true"
			  PackagePath="/" />

		<Compile Include="../EnumClasses.SharedSources/**/*.cs"
				 Link="%(RecursiveDir)%(Filename)%(Extension)"
				 Exclude="../EnumClasses.SharedSources/obj/**/*" />
	</ItemGroup>


	<!-- Only include these packages for non-.NETCoreApp targets (i.e., netstandard2.0) -->
	<ItemGroup Condition="'$(TargetFrameworkIdentifier)' != '.NETCoreApp'">
		<PackageReference Include="System.Collections.Immutable" Version="8.0.0" />
		<PackageReference Include="System.Text.Json" Version="8.0.5" />
		<PackageReference Include="System.Memory" Version="4.6.3" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="../EnumClasses.SourceGenerators/EnumClasses.SourceGenerators.csproj"
						  ReferenceOutputAssembly="false"
						  PrivateAssets="all" />
		<None Include="../EnumClasses.SourceGenerators/bin/$(Configuration)/netstandard2.0/EnumClasses.SourceGenerators.dll"
			  Pack="true"
			  PackagePath="analyzers/dotnet/cs"
			  Visible="false" />
	</ItemGroup>

</Project>
