<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <add key="globalPackagesFolder" value="obj/package-cache" />
  </config>
  <packageSources>
    <clear />
    <add key="package-under-test" value="obj/local-package-source" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
